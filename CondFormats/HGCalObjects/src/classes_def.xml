<lcgdict>

  <!-- HGCal geometry & indexing configuration -->
  <class name="HGCalMappingCellIndexer" class_version="0">
    <field name="typeCodeIndexer_" mapping="blob"/>
    <field name="maxErx_" mapping="blob"/>
    <field name="offsets_" mapping="blob"/>
    <field name="di_" mapping="blob"/>
  </class>

  <class name="HGCalMappingCellIndexerTrigger" class_version="0">
    <field name="typeCodeIndexer_" mapping="blob"/>
    <field name="maxROC_" mapping="blob"/>
    <field name="maxTrLink_" mapping="blob"/>
    <field name="maxTCPerLink_" mapping="blob"/>
    <field name="offsets_" mapping="blob"/>
    <field name="di_" mapping="blob"/>
  </class>
  
  <class name="HGCalFEDReadoutSequence" class_version="0">
    <field name="readoutTypes_" mapping="blob"/>
    <field name="modOffsets_" mapping="blob"/>
    <field name="erxOffsets_" mapping="blob"/>
    <field name="chDataOffsets_" mapping="blob"/>
  </class>

  <class name="HGCalTriggerFEDReadoutSequence" class_version="0">
    <field name="readoutTypes_" mapping="blob"/>
    <field name="modOffsets_" mapping="blob"/>
    <field name="TrLinkOffsets_" mapping="blob"/>
    <field name="TCOffsets_" mapping="blob"/>
  </class>

  <class name="HGCalMappingModuleIndexer" class_version="0">
    <field name="fedReadoutSequences_" mapping="blob"/>
    <field name="globalTypesCounter_" mapping="blob"/>
    <field name="globalTypesNWords_" mapping="blob"/>
    <field name="globalTypesOffsets_" mapping="blob"/>
  </class>

  <class name="HGCalMappingModuleIndexerTrigger" class_version="0">
    <field name="fedReadoutSequences_" mapping="blob"/>
    <field name="globalTypesCounter_" mapping="blob"/>
    <field name="globalTypesNTCs_" mapping="blob"/>
    <field name="globalTypesOffsets_" mapping="blob"/>
  </class>

  <!-- HGCal electronics configuration -->
  <class name="HGCalConfiguration" class_version="0">
    <field name="map" mapping="blob"/>
    <field name="rocs" mapping="blob"/>
    <field name="econds" mapping="blob"/>
    <field name="feds" mapping="blob"/>
  </class>

  <class name="HGCalFedConfig" class_version="0">
    <field name="passthroughMode" mapping="blob"/>
    <field name="cbHeaderMarker" mapping="blob"/>
    <field name="slinkHeaderMarker" mapping="blob"/>
    <field name="delay" mapping="blob"/>
  </class>

  <class name="HGCalECONDConfig" class_version="0">
    <field name="headerMarker" mapping="blob"/>
  </class>

  <class name="HGCalROCConfig" class_version="0">
    <field name="charMode" mapping="blob"/>
  </class>

  <class name="HGCalDenseIndexerBase" class_version="0">
    <field name="vmax_" mapping="blob"/>
  </class>


  <!-- HGCal channel calibration conditions -->
  <class name="HGCalADCPedestalsModulePayload" class_version="0">
    <field name="typecode" mapping="blob"/>
    <field name="adcPed" mapping="blob"/>
  </class>

  <class name="HGCalADCPedestalsPayload" class_version="0">
    <field name="modules" mapping="blob"/>
  </class>

  <class name="HGCalNoiseModulePayload" class_version="0">
    <field name="typecode" mapping="blob"/>
    <field name="noise" mapping="blob"/>
  </class>

  <class name="HGCalNoisePayload" class_version="0">
    <field name="modules" mapping="blob"/>
  </class>

  <class name="HGCalCommonModePedestalsModulePayload" class_version="0">
    <field name="typecode" mapping="blob"/>
    <field name="cmPed" mapping="blob"/>
  </class>

  <class name="HGCalCommonModePedestalsPayload" class_version="0">
    <field name="modules" mapping="blob"/>
  </class>

  <class name="HGCalCommonModeSlopeModulePayload" class_version="0">
    <field name="typecode" mapping="blob"/>
    <field name="cmSlope" mapping="blob"/>
  </class>

  <class name="HGCalCommonModeSlopePayload" class_version="0">
    <field name="modules" mapping="blob"/>
  </class>

  <class name="HGCalCalibrationValidityModulePayload" class_version="0">
    <field name="typecode" mapping="blob"/>
    <field name="valid" mapping="blob"/>
  </class>

  <class name="HGCalCalibrationValidityPayload" class_version="0">
    <field name="modules" mapping="blob"/>
  </class>

</lcgdict>
